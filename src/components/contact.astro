---
import type { SiteSettings } from "@/lib/types";

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;

const field =
  "px-4 py-3 bg-[color:var(--panel)] text-[var(--white)] placeholder:text-[color:var(--ph)] border border-[var(--white-icon-tr)] rounded-md focus:outline-none focus:ring-2 focus:ring-[var(--sec)] w-full";
---

<section id="contact" class="w-full py-20 md:py-28 border-t border-[color:var(--line)]">
  <div class="max-w-5xl mx-auto">
    <h2 class="eyebrow mb-3 rv">Let's talk</h2>
    <h3 class="display text-4xl md:text-5xl leading-[1.1] text-[var(--white)] mb-6 rv" style="--d:.08s">
      Contact
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="rv text-[var(--white-icon)] space-y-4">
        <p class="max-w-[42ch]">
          Hiring, collaborating, or just have a question? Send a message and I'll reply by email.
        </p>
        {
          settings.location && (
            <div class="flex items-center gap-2">
              <span>Location:</span>
              <span class="text-[var(--white)]">{settings.location}</span>
            </div>
          )
        }
        {
          settings.email && (
            <div class="flex items-center gap-2">
              <span>Email:</span>
              <a class="text-[var(--white)] hover:text-[var(--sec)] transition-colors" href={`mailto:${settings.email}`}>
                {settings.email}
              </a>
            </div>
          )
        }
      </div>

      <div class="rv" style="--d:.12s">
        <form id="contact-form" action="/api/contact" method="POST" class="flex flex-col gap-4" novalidate>
          <label class="sr-only" for="c-name">Name</label>
          <input id="c-name" type="text" name="name" placeholder="Name" required maxlength="120" autocomplete="name" class={field} />
          <label class="sr-only" for="c-email">Email</label>
          <input id="c-email" type="email" name="email" placeholder="Email" required maxlength="200" autocomplete="email" class={field} />
          <label class="sr-only" for="c-message">Message</label>
          <textarea id="c-message" name="message" placeholder="Message" rows="6" required minlength="5" maxlength="4000" class={`${field} resize-none`}></textarea>

          <!-- Honeypot: tidak terlihat oleh manusia, sering diisi bot -->
          <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
            <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
          </div>

          <button
            id="contact-submit"
            type="submit"
            class="px-4 py-3 bg-[var(--sec)] text-[color:var(--on-sec)] font-semibold rounded-md transition hover:brightness-110 disabled:opacity-50 disabled:cursor-wait"
          >
            Send message
          </button>
          <p id="form-error" role="alert" class="hidden text-[color:var(--err)] text-sm"></p>
        </form>
        <div
          id="form-message"
          role="status"
          class="hidden items-center gap-3 text-[var(--white)] text-lg border border-[color:var(--ok-border)] bg-[color:var(--ok-bg)] rounded-md p-5"
        >
          <span class="size-2.5 rounded-full bg-[color:var(--ok)] shrink-0"></span>
          Thanks, your message was sent.
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const ok = document.getElementById("form-message");
  const err = document.getElementById("form-error");
  const btn = document.getElementById("contact-submit") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !btn || !err || !ok) return;
    err.classList.add("hidden");

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = "Sending…";

    try {
      const res = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        form.style.display = "none";
        ok.classList.remove("hidden");
        ok.classList.add("flex");
      } else {
        err.textContent = data.error ?? "Something went wrong. Please try again.";
        err.classList.remove("hidden");
      }
    } catch {
      err.textContent = "No connection. Please try again.";
      err.classList.remove("hidden");
    } finally {
      btn.disabled = false;
      btn.textContent = original;
    }
  });
</script>
