---
import { safeUrl } from "@/lib/format";
import type { SiteSettings } from "@/lib/types";

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
const currentYear = new Date().getFullYear();

const links = [
  {
    label: "GitHub",
    href: safeUrl(settings.github_url),
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.9.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85 0 1.7.11 2.5.34 1.9-1.29 2.74-1.02 2.74-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10z"/></svg>',
  },
  {
    label: "LinkedIn",
    href: safeUrl(settings.linkedin_url),
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-9.5 7.5H7v8h2.5zM8.25 6.5a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9m9.25 6.1c0-2.2-1.2-3.3-2.8-3.3-1.2 0-1.8.7-2.1 1.2v-1h-2.5c0 .6 0 8 0 8h2.5v-4.4c0-.3 0-.5.1-.7.2-.5.7-1 1.4-1 1 0 1.4.8 1.4 1.9v4.2h2.5z"/></svg>',
  },
  {
    label: "Email",
    href: settings.email ? `mailto:${settings.email}` : null,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7"><path d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"/></svg>',
  },
].filter((l) => l.href);
---

<footer class="w-full py-12 border-t border-[color:var(--line)]">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <div>
        <p class="text-xl font-medium text-[var(--white)]">{settings.full_name}</p>
        <p class="text-[var(--white-icon)] mt-1">{settings.headline}</p>
      </div>

      {
        links.length > 0 && (
          <div class="flex gap-6">
            {links.map((l) => (
              <a
                href={l.href!}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={l.label}
                class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out"
              >
                <Fragment set:html={l.icon} />
              </a>
            ))}
          </div>
        )
      }
    </div>

    <div class="mt-10 pt-8 border-t border-[color:var(--line)] text-sm text-[var(--white-icon)] flex flex-col gap-2 md:flex-row md:justify-between">
      <p>Built with Astro, Tailwind CSS, Supabase, and Vercel.</p>
      <!-- Lisensi MIT: pemberitahuan hak cipta template asli tidak boleh dihapus -->
      <p>
        © {currentYear} {settings.full_name}. Template by{" "}
        <a target="_blank" rel="noopener noreferrer" class="hover:text-[var(--white)] transition duration-300" href="https://github.com/Gothsec">Andres Hernandez</a>,
        distributed by{" "}
        <a target="_blank" rel="noopener noreferrer" class="hover:text-[var(--white)] transition duration-300" href="https://themewagon.com">ThemeWagon</a>.
      </p>
    </div>
  </div>
</footer>
