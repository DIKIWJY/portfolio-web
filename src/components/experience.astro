---
import { bullets } from "@/lib/format";
import type { Experience } from "@/lib/types";

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section id="experience" class="py-20 md:py-28 border-t border-[color:var(--line)] text-[var(--white)]">
      <div class="max-w-5xl mx-auto grid md:grid-cols-[240px_1fr] gap-6 md:gap-12">
        <div>
          <h2 class="eyebrow mb-3 rv">Where I've worked</h2>
          <h3 class="display text-4xl leading-[1.1] rv" style="--d:.08s">Experience</h3>
        </div>

        <ol class="min-w-0">
          {items.map((x, i) => {
            const points = bullets(x.summary);
            return (
              <li class:list={["rv relative pl-8 border-l", i === items.length - 1 ? "border-transparent pb-0" : "border-[color:var(--line2)] pb-12"]}>
                <span
                  class:list={[
                    "absolute -left-[6px] top-2 size-3 rounded-full",
                    x.is_current ? "bg-[var(--sec)] ring-4 ring-[color:var(--sec-20)]" : "bg-[color:var(--dot)]",
                  ]}
                ></span>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <h4 class="display text-xl md:text-2xl leading-tight">{x.role}</h4>
                  {x.period && <span class="text-sm text-[var(--white-icon)]">{x.period}</span>}
                </div>
                <p class="mt-1 text-[var(--white-icon)]">
                  <span class="text-[var(--white)]">{x.company}</span>
                  {x.location && <span class="ml-3">{x.location}</span>}
                </p>
                {points.length > 0 && (
                  <ul class="mt-4 space-y-2.5 max-w-[62ch]">
                    {points.map((p) => (
                      <li class="relative pl-5 text-[16px] leading-relaxed opacity-90 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-3 before:bg-[var(--sec)]">
                        {p}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )
}
