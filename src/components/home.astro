---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import { safeUrl } from "@/lib/format";
import { social } from "@/lib/social";
import type { TechIcon } from "@/lib/techIcons";
import type { SiteSettings } from "@/lib/types";

interface Props {
  settings: SiteSettings;
  techs: TechIcon[];
}
const { settings, techs } = Astro.props;

const github = safeUrl(settings.github_url);
const linkedin = safeUrl(settings.linkedin_url);
const cv = safeUrl(settings.cv_url);
const hasHighlights = settings.highlights.length > 0;

const iconBtn =
  "text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out border border-[var(--white-icon-tr)] size-12 sm:size-14 flex items-center justify-center rounded-md bg-[color:var(--panel)] hover:bg-[var(--white-icon-tr)]";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto md:pt-36 md:pb-10 pb-8">
    <div class="grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] gap-8 lg:gap-12 items-center">
      <div class="hero-seq">
        {
          settings.available && (
            <p class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 rounded-md border border-[color:var(--ok-border)] bg-[color:var(--ok-bg)] pl-3 pr-4 py-1.5 text-[13px] sm:text-sm">
              <span class="relative flex size-2.5">
                <span class="absolute inline-flex h-full w-full rounded-full bg-[color:var(--ok)] opacity-60 pulse-dot"></span>
                <span class="relative inline-flex size-2.5 rounded-full bg-[color:var(--ok)]"></span>
              </span>
              <span class="font-medium text-[color:var(--ok-text)]">Open to work</span>
              {settings.availability_note && (
                <span class="text-[var(--white-icon)]">{settings.availability_note}</span>
              )}
            </p>
          )
        }

        <p class="text-lg md:text-xl text-[var(--white-icon)]">
          Hi, I'm <span class="text-[var(--white)]">{settings.full_name}</span>
        </p>

        <h1 class="display text-[2.6rem] sm:text-6xl md:text-[4.25rem] leading-[1.08] text-balance">
          {settings.headline}
        </h1>

        <p class="text-base sm:text-lg md:text-xl text-[var(--white-icon)] leading-relaxed max-w-[44ch]">
          {settings.tagline}
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2 w-full">
          <div class="flex gap-3 w-full sm:w-auto">
            {
              cv ? (
                <a
                  href={cv}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 h-12 sm:h-14 px-5 sm:px-6 whitespace-nowrap rounded-md bg-[var(--sec)] text-[color:var(--on-sec)] font-semibold hover:brightness-110 transition"
                >
                  <Fragment set:html={social.download} />
                  Download CV
                </a>
              ) : (
                <a
                  href="#contact"
                  class="flex-1 sm:flex-none inline-flex items-center justify-center h-12 sm:h-14 px-5 sm:px-6 whitespace-nowrap rounded-md bg-[var(--sec)] text-[color:var(--on-sec)] font-semibold hover:brightness-110 transition"
                >
                  Contact me
                </a>
              )
            }
            {
              cv && (
                <a
                  href="#contact"
                  class="flex-1 sm:flex-none inline-flex items-center justify-center h-12 sm:h-14 px-5 sm:px-6 whitespace-nowrap rounded-md border border-[var(--white-icon-tr)] bg-[color:var(--panel)] hover:bg-[var(--white-icon-tr)] transition font-medium"
                >
                  Contact me
                </a>
              )
            }
          </div>
          <span class="hidden sm:block w-px h-8 bg-[color:var(--line2)] mx-1"></span>
          <div class="flex gap-3">
            {github && (
              <a href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class={iconBtn}>
                <Fragment set:html={social.github} />
              </a>
            )}
            {linkedin && (
              <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class={iconBtn}>
                <Fragment set:html={social.linkedin} />
              </a>
            )}
            {settings.email && (
              <a href={`mailto:${settings.email}`} aria-label="Email" class={iconBtn}>
                <Fragment set:html={social.mail} />
              </a>
            )}
          </div>
        </div>
      </div>

      <div class="hero-card relative overflow-hidden rounded-xl border border-[#ffffff1c] min-h-[260px] lg:min-h-[420px]">
        <div class="absolute inset-0" aria-hidden="true">
          <LetterGlitch
            client:visible
            glitchColors={["#5e4491", "#A476FF", "#241a38"]}
            glitchSpeed={33}
            centerVignette={false}
            outerVignette={true}
            smooth={true}
          />
        </div>
        {
          hasHighlights && (
            <div class="relative h-full grid grid-cols-2 gap-px bg-[#ffffff14] min-h-[inherit]">
              {settings.highlights.map((h) => (
                <div class="flex flex-col justify-end p-5 md:p-7 min-h-[130px] md:min-h-[150px] bg-gradient-to-t from-[#101010f0] via-[#101010b0] to-[#10101080]">
                  <span data-count class="display text-4xl md:text-6xl text-[#ececec] [text-shadow:0_2px_24px_#101010]">{h.value}</span>
                  <span class="mt-2 text-sm md:text-[15px] text-[#b4b4bc] leading-snug">{h.label}</span>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>

    {techs.length >= 4 && <div class="mt-16"><LogoWall techs={techs} /></div>}
  </div>
</section>

<style is:global>
  /* Satu urutan masuk saat halaman dibuka: teks naik berurutan, lalu kartu. */
  .hero-seq {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .hero-seq > * {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-seq > :nth-child(2) { animation-delay: 0.06s; }
  .hero-seq > :nth-child(3) { animation-delay: 0.12s; }
  .hero-seq > :nth-child(4) { animation-delay: 0.18s; }
  .hero-seq > :nth-child(5) { animation-delay: 0.24s; }
  .hero-card {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .pulse-dot {
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    80%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
</style>
