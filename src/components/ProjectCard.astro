---
import type { Project } from "@/lib/types";
import { initials, safeUrl } from "@/lib/format";

interface Props {
  project: Project;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const href = `/projects/${project.slug}`;
const repo = safeUrl(project.repo_url);
const demo = safeUrl(project.demo_url);
const meta = [project.status, project.year].filter(Boolean).join(" · ");

const iconBtn =
  "size-12 flex justify-center items-center text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out border border-[var(--white-icon-tr)] rounded-md bg-[color:var(--panel)] hover:bg-[var(--white-icon-tr)]";
---

<article class="group spot rv flex flex-col" style={`--d:${(index % 2) * 0.12}s`}>
  <a
    href={href}
    class="cover block rounded-xl overflow-hidden border border-[var(--white-icon-tr)] bg-[color:var(--panel-solid)] mb-4 aspect-[3/2] relative"
    aria-label={`Lihat studi kasus ${project.title}`}
    tabindex="-1"
  >
    {
      project.cover_url ? (
        <img
          src={project.cover_url}
          alt={`Cuplikan layar ${project.title}`}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div class="w-full h-full grid place-items-center display text-7xl text-[color:var(--sec-25)] bg-[radial-gradient(120%_90%_at_20%_10%,var(--sec-12),transparent_60%)]">
          {initials(project.title)}
        </div>
      )
    }
  </a>

  <div class="flex items-start gap-4 px-1">
    <div class="flex-grow min-w-0">
      <h4 class="display text-2xl leading-tight">
        <a href={href} class="hover:text-[var(--sec)] transition-colors">{project.title}</a>
      </h4>
      <p class="text-sm text-[var(--white-icon)] mt-1">{meta}</p>
      {
        project.summary && (
          <p class="text-[var(--white-icon)] mt-3 text-[15px] leading-relaxed line-clamp-3">
            {project.summary}
          </p>
        )
      }
      {
        project.stack.length > 0 && (
          <ul class="flex flex-wrap gap-2 mt-4" aria-label="Teknologi">
            {project.stack.slice(0, 4).map((s) => (
              <li class="mono text-[11px] uppercase px-3 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)]">
                {s}
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      (repo || demo) && (
        <div class="flex gap-2 shrink-0">
          {repo && (
            <a href={repo} target="_blank" rel="noopener noreferrer" aria-label={`Kode sumber ${project.title}`} class={iconBtn}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6" aria-hidden="true">
                <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
              </svg>
            </a>
          )}
          {demo && (
            <a href={demo} target="_blank" rel="noopener noreferrer" aria-label={`Demo ${project.title}`} class={iconBtn}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6" aria-hidden="true">
                <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
              </svg>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
