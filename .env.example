# Salin file ini menjadi .env lalu isi nilainya.
# Ambil dari Supabase Dashboard -> Project Settings -> API
#
# Keduanya aman berada di sisi publik (anon key dilindungi oleh RLS di
# supabase/schema.sql). JANGAN PERNAH memasukkan service_role key di sini.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# --- Opsional: notifikasi email saat ada pesan masuk (resend.com, gratis) ---
# Tanpa domain sendiri, Resend hanya mengizinkan kirim ke email akun Resend Anda.
# Jangan pakai awalan PUBLIC_ agar nilainya tidak bocor ke browser.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
